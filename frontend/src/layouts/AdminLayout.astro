---
interface Props {
  title: string;
  activeNav?: 'dashboard' | 'posts' | 'categories' | 'tags';
}

const { title, activeNav = 'dashboard' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Admin</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    <div class="admin-wrapper">
      <aside class="sidebar">
        <div class="sidebar-header">
          <a href="/admin" class="logo">Admin Panel</a>
        </div>
        <nav class="sidebar-nav">
          <a href="/admin" class:list={[activeNav === 'dashboard' && 'active']}>
            <span class="icon">📊</span>
            Dashboard
          </a>
          <a href="/admin/posts" class:list={[activeNav === 'posts' && 'active']}>
            <span class="icon">📝</span>
            Posts
          </a>
          <a href="/admin/categories" class:list={[activeNav === 'categories' && 'active']}>
            <span class="icon">📁</span>
            Categories
          </a>
          <a href="/admin/tags" class:list={[activeNav === 'tags' && 'active']}>
            <span class="icon">🏷️</span>
            Tags
          </a>
        </nav>
        <div class="sidebar-footer">
          <a href="/" class="view-site">← View Site</a>
          <button id="logout-btn" class="logout-btn">Logout</button>
        </div>
      </aside>

      <div class="main-content">
        <header class="top-bar">
          <button class="mobile-menu-toggle" aria-label="Toggle menu">☰</button>
          <h1 class="page-title">{title}</h1>
        </header>

        <main class="content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      // Logout handler
      const logoutBtn = document.getElementById('logout-btn');
      logoutBtn?.addEventListener('click', async () => {
        try {
          const res = await fetch('/api/v1/logout', {
            method: 'DELETE',
            credentials: 'include',
          });
          if (res.ok) {
            window.location.href = '/admin/login';
          } else {
            alert('Logout failed. Please try again.');
          }
        } catch (error) {
          alert('Logout failed. Please try again.');
        }
      });

      // Mobile menu toggle
      const menuToggle = document.querySelector('.mobile-menu-toggle');
      const sidebar = document.querySelector('.sidebar');
      menuToggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('open');
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    --color-bg: #f5f5f5;
    --color-sidebar: #1a1a1a;
    --color-sidebar-text: #e0e0e0;
    --color-sidebar-hover: #2a2a2a;
    --color-sidebar-active: #0066cc;
    --color-text: #1a1a1a;
    --color-text-muted: #666666;
    --color-border: #e0e0e0;
    --color-link: #0066cc;
    --color-link-hover: #0052a3;
    --sidebar-width: 240px;
  }

  html {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }

  body {
    min-height: 100vh;
  }

  .admin-wrapper {
    display: flex;
    min-height: 100vh;
  }

  .sidebar {
    width: var(--sidebar-width);
    background: var(--color-sidebar);
    color: var(--color-sidebar-text);
    display: flex;
    flex-direction: column;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
  }

  .sidebar-header {
    padding: 1.5rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sidebar-header .logo {
    color: white;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1rem 0;
  }

  .sidebar-nav a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: var(--color-sidebar-text);
    text-decoration: none;
    transition: background 0.2s;
  }

  .sidebar-nav a:hover {
    background: var(--color-sidebar-hover);
  }

  .sidebar-nav a.active {
    background: var(--color-sidebar-active);
    color: white;
  }

  .sidebar-nav .icon {
    font-size: 1.25rem;
  }

  .sidebar-footer {
    padding: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .view-site {
    color: var(--color-sidebar-text);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.5rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .view-site:hover {
    background: var(--color-sidebar-hover);
  }

  .logout-btn {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-sidebar-text);
    padding: 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .logout-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .main-content {
    flex: 1;
    margin-left: var(--sidebar-width);
    display: flex;
    flex-direction: column;
  }

  .top-bar {
    background: white;
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--color-text);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .content {
    padding: 2rem;
    flex: 1;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      transition: transform 0.3s;
      z-index: 1000;
    }

    .sidebar.open {
      transform: translateX(0);
    }

    .main-content {
      margin-left: 0;
    }

    .mobile-menu-toggle {
      display: block;
    }

    .content {
      padding: 1rem;
    }
  }
</style>
