---
import Layout from '../../../layouts/Layout.astro';
import PostList from '../../../components/PostList.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPostsByCategory, getCategories, type Post, type PaginationMeta, type Category } from '../../../lib/api';

const { slug } = Astro.params;
const page = Number(Astro.url.searchParams.get('page') || 1);

let posts: Post[] = [];
let meta: PaginationMeta = { current_page: 1, per_page: 10, total_entries: 0, total_pages: 1 };
let category: Category | undefined;
let error: string | null = null;

try {
  const categories = await getCategories();
  category = categories.find(c => c.slug === slug);

  if (!category) {
    error = `Category "${slug}" not found`;
  } else {
    const response = await getPostsByCategory(category.id, page);
    posts = response.data;
    meta = response.meta;
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load posts';
}
---

<Layout title={category ? `${category.name} - Blog - Ryan Riegel` : 'Category Not Found'}>
  <h1>{category ? category.name : 'Category Not Found'}</h1>

  {error && (
    <p class="error">⚠️ {error}</p>
  )}

  {posts.length === 0 && !error && (
    <p>No posts in this category yet.</p>
  )}

  {posts.length > 0 && (
    <>
      <PostList posts={posts} />
      <Pagination currentPage={meta.current_page} totalPages={meta.total_pages} basePath={`/blog/category/${slug}`} />
    </>
  )}

  <p><a href="/blog">← All posts</a></p>
</Layout>

<style>
  .error {
    color: #cc0000;
    background: #fff0f0;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }
</style>
