---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts, type Post, type PaginationMeta } from '../../lib/api';

const page = Number(Astro.url.searchParams.get('page') || 1);

let posts: Post[] = [];
let meta: PaginationMeta = { current_page: 1, per_page: 10, total_entries: 0, total_pages: 1 };
let error: string | null = null;

try {
  const response = await getPosts(page);
  posts = response.data;
  meta = response.meta;
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load posts';
}
---

<Layout title="Blog - Ryan Riegel">
  <h1>Blog</h1>

  {error && (
    <p class="error">⚠️ {error}</p>
  )}

  {posts.length === 0 && !error && (
    <p>No posts yet. Check back soon!</p>
  )}

  {posts.length > 0 && (
    <>
      <PostList posts={posts} />
      <Pagination currentPage={meta.current_page} totalPages={meta.total_pages} basePath="/blog" />
    </>
  )}
</Layout>

<style>
  .error {
    color: #cc0000;
    background: #fff0f0;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }
</style>
