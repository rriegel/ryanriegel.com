---
import { getFeedPosts, type Post } from '../lib/api';

const siteUrl = import.meta.env.SITE_URL || 'https://ryanriegel.com';

let posts: Post[] = [];
try {
  const response = await getFeedPosts(20);
  posts = response.data;
} catch (e) {
  // Empty feed on error
}

// Post bodies are stored relative to the site origin (e.g. blob paths like
// /rails/active_storage/...). Feed readers render item HTML out of context,
// so relative srcs break. Rewrite src/href to absolute URLs against SITE_URL.
function absolutizeUrls(html: string, base: string): string {
  if (!html) return html;
  const baseNoTrail = base.replace(/\/+$/, '');
  return html
    .replace(/(src|href)\s*=\s*"((?!https?:|\/\/|mailto:|#|data:)[^"]*)"/gi,
      (_m, attr: string, url: string) => `${attr}="${baseNoTrail}${url.startsWith('/') ? url : '/' + url}"`)
    .replace(/(src|href)\s*=\s*'((?!https?:|\/\/|mailto:|#|data:)[^']*)'/gi,
      (_m, attr: string, url: string) => `${attr}='${baseNoTrail}${url.startsWith('/') ? url : '/' + url}'`);
}

// Cover URLs from the API are relative blob paths in dev/SSR (same-origin
// proxy); enclosures must be absolute per the RSS spec. Reuse the same
// scheme/host as SITE_URL.
function absolutizeUrl(url: string, base: string): string {
  if (!url) return url;
  if (/^(https?:)?\/\//i.test(url) || /^[a-z][a-z0-9+.-]*:/i.test(url)) return url;
  const origin = new URL(base).origin;
  return `${origin}${url.startsWith('/') ? url : '/' + url}`;
}

function escapeXml(unsafe: string): string {
  return unsafe
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

// Media type for RSS <enclosure>. Blob content_type is authoritative
// (covers are validated to jpeg/png/webp at upload).
function coverMimeType(contentType?: string | null): string {
  const allowed: Record<string, string> = {
    'image/jpeg': 'image/jpeg',
    'image/png': 'image/png',
    'image/webp': 'image/webp',
  };
  return (contentType && allowed[contentType]) || 'application/octet-stream';
}

const feedItems = posts.map(post => {
  const link = `${siteUrl}/blog/${post.slug}`;
  const pubDate = post.published_at ? new Date(post.published_at).toUTCString() : '';
  const bodyHtml = absolutizeUrls(post.body || post.excerpt || '', siteUrl);
  const enclosure = post.cover_image
    ? `\n      <enclosure url="${escapeXml(absolutizeUrl(post.cover_image, siteUrl))}" type="${coverMimeType(post.cover_image_content_type)}" length="${post.cover_image_byte_size ?? 0}" />`
    : '';

  return `    <item>
      <title><![CDATA[${post.title}]]></title>
      <link>${link}</link>
      <guid isPermaLink="true">${link}</guid>
      <pubDate>${pubDate}</pubDate>
      <description><![CDATA[${bodyHtml}]]></description>
      ${post.category ? `<category>${escapeXml(post.category.name)}</category>` : ''}${enclosure}
    </item>`;
}).join('\n');

const rss = `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Ryan Riegel's Blog</title>
    <link>${siteUrl}</link>
    <description>Software engineer writing about development, projects, and things I'm learning.</description>
    <language>en-us</language>
    <atom:link href="${siteUrl}/rss.xml" rel="self" type="application/rss+xml"/>
    <lastBuildDate>${new Date().toUTCString()}</lastBuildDate>
${feedItems}
  </channel>
</rss>`;

// Return the XML as a raw Response: rendering through the page pipeline
// injects Astro's HTML <!DOCTYPE html> ahead of the XML declaration, which
// makes the feed invalid XML for strict parsers.
return new Response(rss, {
  headers: {
    'Content-Type': 'application/rss+xml; charset=utf-8',
  },
});
---
